{
  "name": "n8n social media automation (Unsora, weekly)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        300,
        0
      ],
      "id": "badf963b-fb38-5119-a1ad-78791a870085",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Write one short post about [your topic] for LinkedIn and Bluesky, and schedule it for today at 10:00 am. Reply with the post ID, the accounts and the scheduled time.",
        "options": {
          "systemMessage": "You manage social media posts through Unsora.\nAlways call get_accounts first to find account IDs.\nNever publish immediately unless I say post now.\nOtherwise, schedule with scheduled_at.\nTo attach images, set mediaType to slideshow\nand put the image URLs in mediaUrls.\nMy timezone is <your timezone>.\nAfter creating a post, reply with the post ID,\nthe accounts and the scheduled time."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        680,
        0
      ],
      "id": "31edf692-ac97-5cab-96c1-8736fb50b7af",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.4"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        620,
        220
      ],
      "id": "eb0dec43-9ca6-551d-8d5e-b20a351cd50e",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "weekly-posting"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        780,
        220
      ],
      "id": "c0e9e9ac-60bb-5929-acbe-7a5a2625c898",
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "endpointUrl": "https://mcp.tryunsora.com/mcp",
        "serverTransport": "httpStreamable",
        "authentication": "headerAuth",
        "include": "selected",
        "includeTools": [
          "get_accounts",
          "create_post",
          "list_posts",
          "get_post",
          "publish_post"
        ],
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1.4,
      "position": [
        940,
        220
      ],
      "id": "6cb4bcb1-d7b2-5139-978e-99d24feab5d6",
      "name": "Unsora"
    },
    {
      "parameters": {
        "content": "## Before you run it\n1. **OpenAI Chat Model**: add your OpenAI credential (or swap in Anthropic).\n2. **Unsora** (MCP Client Tool): create a Header Auth credential. Name: `apiKey`. Value: your Unsora key (in Unsora: Agents > API keys > Create API key; it starts with `uns_` and is shown once).\n3. In **AI Agent > Options > System Message**, set your timezone.\n\nNeeds n8n 1.104 or newer (HTTP Streamable).",
        "height": 300,
        "width": 420
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        -200
      ],
      "id": "469ae354-0016-54f2-9f1c-d072d54414b5",
      "name": "Setup"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Simple Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Unsora": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}